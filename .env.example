# ---------------------------------------------------------------------------
# SEO ENGINE — environment template
# Copy to .env and fill in.  NEVER commit a populated .env file.
# ---------------------------------------------------------------------------

# --- Core infrastructure ---------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/seo_engine
REDIS_URL=redis://localhost:6379/0

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=seo-engine
# local  -> run workflows in-process (no Temporal server required)
# temporal -> submit workflows to the Temporal cluster above
WORKFLOW_ENGINE=local

# --- Security --------------------------------------------------------------
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=14
# Fernet key protecting stored OAuth refresh tokens / API keys.
# Generate with: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=
# local | env  (KMS/vault providers plug in behind the same interface)
SECRET_PROVIDER=local

# --- Language model (optional) ---------------------------------------------
# SEO Engine is model-agnostic and runs completely without a model: every
# analysis, decision and gate is deterministic. A model only writes article
# prose inside a brief; without one the writer produces an honest outline that
# a person completes. Connect any model by choosing its protocol and naming it:
#
#   deterministic      no model (default)
#   openai_compatible  any Chat Completions endpoint, hosted or local; set
#                      LLM_BASE_URL (LLM_API_KEY only if the endpoint needs one)
#                        e.g. https://api.openai.com/v1, https://openrouter.ai/api/v1,
#                             http://localhost:11434/v1 (Ollama),
#                             http://localhost:8000/v1 (vLLM, LM Studio, llama.cpp)
#   anthropic          any model served through the Anthropic Messages API
#                      (needs LLM_API_KEY and the `llm` extra)
#
# LLM_MODEL has no default: it is the name your endpoint uses for the model you
# connected, and it is required whenever LLM_PROVIDER is not deterministic.
# If the configured model is unreachable or misconfigured, the platform keeps
# running deterministically and every affected run says why; /readyz reports
# which model, if any, is in use.
LLM_PROVIDER=deterministic
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
# Unset sends no sampling temperature, so the model's own default applies.
LLM_TEMPERATURE=
# Your prices, USD per million tokens, for the usage ledger. Unset records the
# cost of each call as unknown (never as zero); no price list is built in.
LLM_INPUT_PRICE_PER_MTOK=
LLM_OUTPUT_PRICE_PER_MTOK=

# --- Google (Search Console, Analytics 4, Ads, Business Profile) -----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/integrations/oauth/google/callback
GSC_SCOPES=https://www.googleapis.com/auth/webmasters.readonly
GA4_SCOPES=https://www.googleapis.com/auth/analytics.readonly
GOOGLE_ADS_DEVELOPER_TOKEN=

# --- Third-party SEO data providers ---------------------------------------
AHREFS_API_KEY=
SEMRUSH_API_KEY=
# Observed results pages (SerpApi-compatible). Leave empty to run the labelled
# development adapter: synthetic *.example results, never presented as real.
SERP_API_KEY=
SERP_API_BASE_URL=https://serpapi.com

# --- Object storage (S3 compatible) ---------------------------------------
S3_ENDPOINT=
S3_BUCKET=seo-engine
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# --- Crawler safeguards ----------------------------------------------------
CRAWLER_USER_AGENT=SEOEngineBot/0.1 (+https://seo-engine.local/bot)
CRAWLER_MAX_PAGES=200
CRAWLER_MAX_DEPTH=4
CRAWLER_CONCURRENCY=4
CRAWLER_REQUESTS_PER_SECOND=2.0
CRAWLER_REQUEST_TIMEOUT_SECONDS=20
CRAWLER_RESPECT_ROBOTS=true

# --- Application -----------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
API_CORS_ORIGINS=http://localhost:3000
API_RATE_LIMIT_PER_MINUTE=240
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
